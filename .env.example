# Copie este arquivo para .env apenas no ambiente local.
# Em produção, gere valores novos e armazene-os no gerenciador de segredos da plataforma.

DB_NAME=orderflow
DB_USER=orderflow
DB_PASSWORD=troque-por-uma-senha-forte
POSTGRES_HOST_PORT=5433

REDIS_HOST_PORT=6380
REDIS_PASSWORD=troque-por-outra-senha-forte
REDIS_SSL=false

RABBITMQ_ENABLED=true
RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=troque-por-uma-senha-forte-do-rabbitmq
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_PUBLISHER_CONFIRM_TIMEOUT=5s
RABBITMQ_CONSUMER_MAX_RETRIES=2
RABBITMQ_CONSUMER_RETRY_INITIAL_INTERVAL=1s
RABBITMQ_CONSUMER_RETRY_MULTIPLIER=2
RABBITMQ_CONSUMER_RETRY_MAX_INTERVAL=2s
RABBITMQ_CONSUMER_CONCURRENCY=2
RABBITMQ_CONSUMER_MAX_CONCURRENCY=5
RABBITMQ_CONSUMER_PREFETCH=10
NOTIFICATION_PROCESSED_EVENT_RETENTION=30d
NOTIFICATION_CLEANUP_CRON="0 0 3 * * *"

APP_PORT=8080
ORDERFLOW_DOMAIN=api.orderflow.example.com
GRAFANA_DOMAIN=grafana.orderflow.example.com
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-forte-do-grafana
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=gere-ao-menos-32-bytes-aleatorios-para-producao

# Usado somente pelo perfil docker local. O perfil prod não cria administrador.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Local Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@orderflow.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-local

# Necessários somente quando SPRING_PROFILES_ACTIVE inclui payment-http.
PAYMENT_GATEWAY_BASE_URL=https://sandbox.exemplo.com
PAYMENT_GATEWAY_API_KEY=troque-pela-chave-do-gateway

# Integração oficial usada quando o perfil payment-asaas está ativo.
# Nunca grave a chave real neste arquivo nem em commits.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=''
ASAAS_USER_AGENT=OrderFlow/1.0
ASAAS_PAYMENT_DUE_DAYS=3
ASAAS_CONNECT_TIMEOUT=3s
ASAAS_READ_TIMEOUT=3s
# Token de 32 a 255 caracteres enviado pelo Asaas no header asaas-access-token.
ASAAS_WEBHOOK_TOKEN=gere-um-token-exclusivo-para-o-webhook

# Job distribuído de conciliação financeira. Os padrões são seguros para a aplicação local.
PAYMENT_RECONCILIATION_CRON=0 */15 * * * *
PAYMENT_RECONCILIATION_MIN_AGE=10m
PAYMENT_RECONCILIATION_MAX_AGE=7d
PAYMENT_RECONCILIATION_BATCH_SIZE=200
PAYMENT_RECONCILIATION_LOCK_AT_MOST=15m
PAYMENT_RECONCILIATION_LOCK_AT_LEAST=1m
